class Solution(object):
    def removeDuplicates(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        
        # If array has 2 or fewer elements,
        # all are already valid
        if len(nums) <= 2:
            return len(nums)
        
        # Pointer for placing valid elements
        k = 2
        
        # Start from index 2
        for i in range(2, len(nums)):
            
            # Compare with element two positions before
            # If different, keep it
            if nums[i] != nums[k - 2]:
                nums[k] = nums[i]
                k += 1
        
        return k
